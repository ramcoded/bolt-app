# Supabase — get these from your Supabase project dashboard (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# App public URL — used for CORS (no trailing slash)
# Development: http://localhost:3000  |  Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase service role key — SERVER ONLY, never expose to the browser or commit to git
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
